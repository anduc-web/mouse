#include <Arduino.h>

// ======================================================
// 1. CHAN STM32F411CEU6
// ======================================================
const uint8_t LEFT_IN1  = PA1;
const uint8_t LEFT_IN2  = PA2;
const uint8_t RIGHT_IN1 = PA3;
const uint8_t RIGHT_IN2 = PA5;
const uint8_t MOTOR_SLEEP = PA0;

const uint8_t ENC_LEFT_A  = PB5;
const uint8_t ENC_LEFT_B  = PB4;
const uint8_t ENC_RIGHT_A = PA8;
const uint8_t ENC_RIGHT_B = PA9;

const uint8_t LED_PIN = PC13;

// ======================================================
// 2. THONG SO QUANG DUONG
// ======================================================
const float WHEEL_DIAMETER_MM = 32.0f;
const float ENCODER_COUNTS_PER_REV = 330.0f;
const float TARGET_DISTANCE_MM = 90.0f;   // TEST 9cm

// ======================================================
// 3. THONG SO TOC DO
// ======================================================
const int BASE_DUTY = 55;
const int MIN_DUTY  = 15;
const int MAX_DUTY  = 40;
const float MOTOR_TRIM_RIGHT = 15.0f;

const int START_BOOST_ADD = 12;
const uint32_t START_BOOST_MS = 100;

const long SLOWDOWN_WINDOW = 60;
const int MIN_APPROACH_DUTY = 18;

const uint32_t MAX_RUN_TIME_MS = 8000;

// ======================================================
// 4. BIEN TOAN CUC
// ======================================================
volatile long encoderLeft = 0;
volatile long encoderRight = 0;

bool running = false;
long targetCounts = 0;
uint32_t motionStartMs = 0;
uint32_t lastLedMs = 0;
bool ledState = false;

// ======================================================
// 5. NGAT ENCODER
// ======================================================
void encoderLeftISR()  { encoderLeft++; }
void encoderRightISR() { encoderRight++; }

// ======================================================
// 6. DIEU KHIEN MOTOR - DA DAO CHIEU
// ======================================================
void motorBrake() {
  analogWrite(LEFT_IN1, 255);
  analogWrite(LEFT_IN2, 255);
  analogWrite(RIGHT_IN1, 255);
  analogWrite(RIGHT_IN2, 255);
}

void motorCoast() {
  analogWrite(LEFT_IN1, 0);
  analogWrite(LEFT_IN2, 0);
  analogWrite(RIGHT_IN1, 0);
  analogWrite(RIGHT_IN2, 0);
}

void setMotors(int dL, int dR) {
  dL = constrain(dL, 0, MAX_DUTY);
  dR = constrain(dR, 0, MAX_DUTY);

  int pwmL = map(dL, 0, 100, 0, 255);
  int pwmR = map(dR, 0, 100, 0, 255);

  // Banh trai: DAO - PA1 = 0, PA2 = PWM
  analogWrite(LEFT_IN1, 0);
  analogWrite(LEFT_IN2, pwmL);

  // Banh phai: DAO - PA3 = PWM, PA5 = 0
  analogWrite(RIGHT_IN1, pwmR);
  analogWrite(RIGHT_IN2, 0);
}

// ======================================================
// 7. TINH TARGET
// ======================================================
long getTargetCounts() {
  float circumference = PI * WHEEL_DIAMETER_MM;
  float revolutions = TARGET_DISTANCE_MM / circumference;
  return (long)(revolutions * ENCODER_COUNTS_PER_REV + 0.5f);
}

void readEncoders(long &l, long &r) {
  noInterrupts();
  l = encoderLeft;
  r = encoderRight;
  interrupts();
}

// ======================================================
// 8. SETUP
// ======================================================
void setup() {
  pinMode(LEFT_IN1, OUTPUT);
  pinMode(LEFT_IN2, OUTPUT);
  pinMode(RIGHT_IN1, OUTPUT);
  pinMode(RIGHT_IN2, OUTPUT);
  pinMode(MOTOR_SLEEP, OUTPUT);

  pinMode(ENC_LEFT_A, INPUT_PULLUP);
  pinMode(ENC_LEFT_B, INPUT_PULLUP);
  pinMode(ENC_RIGHT_A, INPUT_PULLUP);
  pinMode(ENC_RIGHT_B, INPUT_PULLUP);

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, HIGH);

  digitalWrite(MOTOR_SLEEP, HIGH);

  motorCoast();

  attachInterrupt(digitalPinToInterrupt(ENC_LEFT_A),  encoderLeftISR,  RISING);
  attachInterrupt(digitalPinToInterrupt(ENC_RIGHT_A), encoderRightISR, RISING);

  targetCounts = getTargetCounts();

  delay(2000);

  noInterrupts();
  encoderLeft = 0;
  encoderRight = 0;
  interrupts();

  int dL = BASE_DUTY + START_BOOST_ADD;
  int dR = BASE_DUTY + START_BOOST_ADD + (int)MOTOR_TRIM_RIGHT;
  setMotors(dL, dR);

  motionStartMs = millis();
  lastLedMs = motionStartMs;
  running = true;
}

// ======================================================
// 9. LOOP
// ======================================================
void loop() {
  if (!running) {
    digitalWrite(LED_PIN, LOW);
    return;
  }

  uint32_t now = millis();
  long l, r;
  readEncoders(l, r);
  long avg = (l + r) / 2;

  // 1. Cham dich
  if (avg >= targetCounts) {
    running = false;
    motorCoast();
    delay(50);
    motorBrake();
    delay(50);
    motorCoast();
    digitalWrite(LED_PIN, LOW);
    return;
  }

  // 2. Timeout
  if (now - motionStartMs > MAX_RUN_TIME_MS) {
    running = false;
    motorCoast();
    delay(50);
    motorBrake();
    delay(50);
    motorCoast();
    for (int i = 0; i < 5; i++) {
      digitalWrite(LED_PIN, LOW);
      delay(100);
      digitalWrite(LED_PIN, HIGH);
      delay(100);
    }
    digitalWrite(LED_PIN, LOW);
    return;
  }

  // 3. Quy dao toc do
  float centerDuty = (float)BASE_DUTY;

  if (now - motionStartMs < START_BOOST_MS) {
    float bf = 1.0f - (float)(now - motionStartMs) / (float)START_BOOST_MS;
    centerDuty += (float)START_BOOST_ADD * bf;
  }

  long remain = targetCounts - avg;
  if (remain < SLOWDOWN_WINDOW && remain > 0) {
    float ratio = (float)remain / (float)SLOWDOWN_WINDOW;
    float decel = MIN_APPROACH_DUTY + (BASE_DUTY - MIN_APPROACH_DUTY) * ratio;
    if (decel < centerDuty) centerDuty = decel;
  }

  int dL = (int)roundf(centerDuty);
  int dR = (int)roundf(centerDuty + MOTOR_TRIM_RIGHT);
  dL = constrain(dL, MIN_DUTY, MAX_DUTY);
  dR = constrain(dR, MIN_DUTY, MAX_DUTY);

  setMotors(dL, dR);

  // 4. LED nhay khi chay
  if (now - lastLedMs > 300) {
    lastLedMs = now;
    ledState = !ledState;
    digitalWrite(LED_PIN, ledState ? LOW : HIGH);
  }
}
